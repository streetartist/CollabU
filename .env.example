# CollabU Docker Compose 环境变量示例
# 复制为 .env 并修改其中的强密码/密钥后再使用：
#   cp .env.example .env

# ---------- 安全密钥（生产环境务必修改） ----------
# Flask 应用的密钥
SECRET_KEY=please-change-this-secret-key
# JWT 签名密钥
JWT_SECRET_KEY=please-change-this-jwt-secret-key

# ---------- MySQL 配置 ----------
# MySQL root 密码
MYSQL_ROOT_PASSWORD=please-change-root-password
# 应用使用的数据库名
MYSQL_DATABASE=collabu
# 应用使用的数据库用户
MYSQL_USER=collabu
# 应用使用的数据库用户密码
MYSQL_PASSWORD=please-change-db-password

# ---------- Web 端口 ----------
# 前端对外暴露的端口（默认 80）
WEB_PORT=80
